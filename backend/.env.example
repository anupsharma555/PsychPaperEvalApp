APP_NAME=PaperEval
ENVIRONMENT=local
DATA_DIR=data
MODELS_DIR=models
DB_PATH=data/app.db

PARSER_ENGINE=validated
PARSER_REUSE_UNCHANGED_ASSETS_ENABLED=true

LLM_PROVIDER=local
PSYCHPAPER_OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_DEEP_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SEC=120
OPENAI_JSON_MODE_ENABLED=true
OPENAI_SEND_TEMPERATURE=false
OPENAI_REASONING_EFFORT=minimal
OPENAI_API_MODE=responses
OPENAI_USAGE_GUARDRAILS_ENABLED=true
OPENAI_MAX_COST_PER_RUN_USD=0.15
OPENAI_MAX_COST_PER_DAY_USD=2.00
OPENAI_MAX_CALLS_PER_RUN=36
OPENAI_MAX_OUTPUT_TOKENS_PER_RUN=55000
OPENAI_ESTIMATED_IMAGE_INPUT_TOKENS=2500

LLM_MODEL_PATH=models/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
LLM_MMPROJ_PATH=models/mmproj-Qwen2.5-VL-7B-Instruct-Q8_0.gguf
LLM_CHAT_FORMAT=qwen2.5-vl
LLM_TEXT_MODEL_PATH=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
LLM_TEXT_CHAT_FORMAT=chatml
LLM_DEEP_MODEL_PATH=models/Qwen2.5-14B-Instruct-Q4_K_M.gguf
LLM_DEEP_CHAT_FORMAT=chatml
LLM_VISION_MODEL_PATH=models/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
LLM_VISION_MMPROJ_PATH=models/mmproj-Qwen2.5-VL-7B-Instruct-Q8_0.gguf
LLM_VISION_CHAT_FORMAT=qwen2.5-vl
LLM_N_CTX=8192
LLM_N_THREADS=8
LLM_N_BATCH=512
LLM_N_GPU_LAYERS=999
GGML_METAL_DEVICES=0
LOCAL_GPU_SMOKE_ENABLED=true
LOCAL_GPU_SMOKE_TIMEOUT_SEC=120
LLM_TEXT_MAX_TOKENS=6000
LLM_DEEP_MAX_TOKENS=3500
LLM_VISION_MAX_TOKENS=1200
LLM_IMAGE_MAX_DIM=1024
LLM_IMAGE_MAX_PIXELS=1500000
LLM_IMAGE_FORMAT=jpeg
LLM_IMAGE_QUALITY=85

FETCH_TIMEOUT_SEC=60
FETCH_USER_AGENT=PaperEval/0.1
UNPAYWALL_EMAIL=

GROBID_URL=http://localhost:8070
GROBID_TIMEOUT_SEC=120
GROBID_CONSOLIDATE_HEADER=true
GROBID_CONSOLIDATE_CITATIONS=true
GROBID_INCLUDE_COORDINATES=true
PAPER_EVAL_MANAGE_GROBID=true
PAPER_EVAL_STOP_GROBID_ON_EXIT=true
PAPER_EVAL_START_DOCKER_DESKTOP=true
PAPER_EVAL_DOCKER_DESKTOP_HIDDEN=true

PDFFIGURES2_CMD=
PDFFIGURES2_JAR=
PDFFIGURES2_TIMEOUT_SEC=180
PDFFIGURES2_HEADLESS=true

ANALYSIS_MAX_TEXT_CHARS=120000
ANALYSIS_MAX_TABLES=50
ANALYSIS_MAX_FIGURES=30
ANALYSIS_MAX_SUPP_ITEMS=50
ANALYSIS_LOCAL_EVIDENCE_FIRST_ENABLED=true
ANALYSIS_TEXT_LLM_BATCH_MAX_CHARS=9000
ANALYSIS_LOCAL_TEXT_LLM_BATCH_MAX_CHARS=9000
ANALYSIS_LOCAL_TEXT_PRESELECTION_ENABLED=true
ANALYSIS_LOCAL_TEXT_PRESELECTION_MAX_CHUNKS=12
ANALYSIS_LOCAL_TEXT_PRESELECTION_MIN_CHUNKS_PER_SECTION=2
ANALYSIS_LOCAL_TEXT_CACHE_ENABLED=true
ANALYSIS_LOCAL_TEXT_GLOBAL_CACHE_ENABLED=false
ANALYSIS_LOCAL_TEXT_CACHE_MIN_PACKETS=8
ANALYSIS_LOCAL_TEXT_CACHE_MIN_SECTIONS=3
ANALYSIS_LOCAL_TEXT_CACHE_MAX_MISSING_EVIDENCE_RATE=0.25
ANALYSIS_TEXT_SUBPROCESS_TIMEOUT_SEC=600
ANALYSIS_LOCAL_TEXT_SUBPROCESS_TIMEOUT_SEC=360
ANALYSIS_PARALLEL_MODALITIES_ENABLED=true
ANALYSIS_PARALLEL_MODALITY_WORKERS=4
ANALYSIS_NONTEXT_LLM_ENABLED=true
ANALYSIS_FORCE_NONTEXT_LLM_FOR_OPENAI=true
ANALYSIS_LOCAL_FIGURE_CAPTION_FIRST_ENABLED=true
ANALYSIS_LOCAL_FIGURE_CAPTION_FIRST_MIN_CHARS=80
ANALYSIS_LOCAL_SUPPLEMENT_CAPTION_FIRST_ENABLED=true
ANALYSIS_LOCAL_SUPPLEMENT_CAPTION_FIRST_MIN_CHARS=80
ANALYSIS_NARRATIVE_OVERRIDES_ENABLED=true
ANALYSIS_USE_PROCESS_POOL=true
ANALYSIS_CLEANUP_ORPHANS=true
ANALYSIS_SECTION_VERIFIER_ENABLED=true
ANALYSIS_SECTION_SYNTHESIS_V2_ENABLED=false
ANALYSIS_SECTION_SYNTHESIS_V2_LLM_ENABLED=false

DOCTR_ENABLED=true
DOCTR_DET_ARCH=db_resnet50
DOCTR_RECO_ARCH=crnn_vgg16_bn
DOCTR_MAX_CHARS=4000
TORCH_DEVICE=mps

TATR_DET_MODEL=microsoft/table-transformer-detection
TATR_STRUCT_MODEL=microsoft/table-transformer-structure-recognition
TATR_THRESHOLD=0.6

FIGURE_OCR_ENABLED=true
FIGURE_OCR_LANGS=en
FIGURE_OCR_MAX_CHARS=4000
FIGURE_FALLBACK_MAX_PAGES=6
FIGURE_FALLBACK_SCALE=2.0

RETAIN_SOURCE_FILES=true
