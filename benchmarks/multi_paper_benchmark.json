    },
    {
      "id": "additional_reference_scored_cases",
      "status": "needed",
      "needed_for": ["release", "deep"],
      "reason": "Release and deep tiers define a multi-paper corpus with draft final-report gold standards, but most current cases remain diagnostic coverage cases until sectioned reference markdown is authored and reviewed."
    }
  ],
  "tiers": {
    "smoke": {
      "minimum_cases": 1,
      "requires_reference_scored_cases": 1
    },
    "release": {
      "minimum_cases": 5,
