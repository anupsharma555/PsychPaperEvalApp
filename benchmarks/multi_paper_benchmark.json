  "defaults": {
    "mode": "pipeline",
    "parser_engine": "validated",
    "backend_profile": "section-sensitive",
    "matching_mode": "hybrid",
    "matching_threshold": 0.42,
    "retain_runs": 1,
    "out_dir": "test/multi_paper_benchmark",
    "db_dir": "/tmp"
  },
  "reference_thresholds": {
    "overall_recall_min": 0.68,
    "methods_recall_min": 0.55,
    "results_recall_min": 0.55,
    "section_recall_floor": 0.35
  },
